PORT=5000
MONGO_CONNECTION_STRING=mongodb://localhost:27017/school_management
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=your_cookie_secret
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_pass
SSLCOMMERZ_IS_LIVE=false

# TextBelt SMS (No signup required — https://textbelt.com)
# textbelt_test  → dev mode: logs success, no real SMS sent, unlimited
# textbelt        → 1 free real SMS/day, no account needed
# your_paid_key  → buy credits at textbelt.com ($0.001/SMS)
TEXTBELT_KEY=textbelt_test
